# For running the reminder script locally to test it. In GitHub Actions
# itself, these same values come from repository secrets instead (see
# .github/workflows/reminders.yml) — this file is never used there.
#
# Copy to .env in this folder, fill in real values, and run:
#   node -r dotenv/config index.js
# (or `npm install dotenv` first if you don't already have it)

# The full contents of a Firebase service account key JSON, as one
# single-line string. Generate one at:
# Firebase console → Project settings → Service accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}

# Same RAWG key used in public/index.html — free key from https://rawg.io/apidocs
RAWG_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Release Board <reminders@yourdomain.com>"
